; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Junk Construction Simulator"
config/description="Sandbox de engenharia: pegue sucata, corte, solde e construa máquinas."
config/version="0.7.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameInput="*res://scripts/core/game_input.gd"
Build="*res://scripts/core/build_manager.gd"
Settings="*res://scripts/core/settings.gd"
Economy="*res://scripts/core/economy.gd"
Saves="*res://scripts/core/saves.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
common/max_physics_steps_per_frame=6
jolt_physics_3d/simulation/velocity_steps=12
jolt_physics_3d/simulation/penetration_slop=0.005

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
